                 fontName="SansSerif" fontSize="6.0">
            <expression><![CDATA[$P{K8_NOTA}]]></expression>
        </element>

        <!-- ── Ingresos por mes ── -->
        <element kind="staticText" x="0" y="214" width="545" height="14" forecolor="#22366B"
                 fontName="SansSerif" fontSize="11.0" bold="true" vTextAlign="Middle">
            <text><![CDATA[Facturación y cobranza por mes]]></text>
        </element>
        <element kind="image" x="0" y="230" width="545" height="150" scaleImage="RetainShape"
                 hImageAlign="Left" vImageAlign="Top">
            <expression><![CDATA[$P{GRAFICO_INGRESOS}]]></expression>
        </element>

        <!-- ── Composición ── -->
        <element kind="staticText" x="0" y="390" width="265" height="14" forecolor="#22366B"

    <detail>
        <band height="15">
            <element kind="textField" x="4" y="0" width="196" height="15" forecolor="#1F2937"
                     fontName="SansSerif" fontSize="8.0" vTextAlign="Middle">
                <expression><![CDATA[$F{titulo}]]></expression>
            </element>
            <element kind="textField" x="200" y="0" width="111" height="15" forecolor="#6B7280"
                     fontName="SansSerif" fontSize="7.5" vTextAlign="Middle">
                <expression><![CDATA[$F{subtitulo}]]></expression>
            </element>
            <element kind="textField" x="315" y="0" width="66" height="15" forecolor="#1F2937"
                     fontName="SansSerif" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle">
                <expression><![CDATA[$F{valor1}]]></expression>
            </element>
            <element kind="textField" x="381" y="0" width="76" height="15" forecolor="#1F2937"
                     fontName="SansSerif" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle">
                <expression><![CDATA[$F{valor2}]]></expression>
            </element>
            <element kind="textField" x="461" y="0" width="80" height="15" forecolor="#1F2937"
                     fontName="SansSerif" fontSize="8.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
                <expression><![CDATA[$F{valor3}]]></expression>
            </element>
            <element kind="line" x="0" y="14" width="545" height="1" forecolor="#EEF2F7">
                <pen lineWidth="0.5"/>
            </element>
        </band>
    </detail>

    <pageFooter height="24">
        <element kind="line" x="0" y="4" width="545" height="1" forecolor="#E2E8F0">
            <pen lineWidth="0.5"/>
        </element>
        <element kind="staticText" x="0" y="8" width="330" height="12" forecolor="#94A3B8"
                 fontName="SansSerif" fontSize="7.0">
            <text><![CDATA[Eventos Caná · Reporte estadístico generado por el sistema interno]]></text>
        </element>
        <!-- Dos campos: el total de paginas solo se conoce al final (Master), el
             numero actual no. Un solo campo con evaluationTime="Master" imprimiria
             el total en todas las paginas. -->
        <element kind="textField" x="330" y="8" width="180" height="12" forecolor="#94A3B8"
                 fontName="SansSerif" fontSize="7.0" hTextAlign="Right">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></expression>
        </element>
        <element kind="textField" x="510" y="8" width="35" height="12" forecolor="#94A3B8"
                 fontName="SansSerif" fontSize="7.0" hTextAlign="Left" evaluationTime="Master">
            <expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>

</jasperReport>

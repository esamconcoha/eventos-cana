            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </element>
        <element kind="textField" x="417" y="120" width="122" height="10" forecolor="#64748B"
                 fontName="SansSerif" fontSize="6.5" bold="true">
            <expression><![CDATA[$P{K4_LABEL}]]></expression>
        </element>
        <element kind="textField" x="417" y="130" width="122" height="18" forecolor="#B45309"
                 fontName="SansSerif" fontSize="13.0" bold="true" vTextAlign="Middle">
            <expression><![CDATA[$P{K4_VALOR}]]></expression>
        </element>
        <element kind="textField" x="417" y="147" width="122" height="9" forecolor="#94A3B8"
                 fontName="SansSerif" fontSize="6.0">
            <expression><![CDATA[$P{K4_NOTA}]]></expression>
        </element>

        <!-- ── Indicadores, fila 2 ── -->
        <element kind="rectangle" x="0" y="162" width="134" height="42" radius="4"
                 forecolor="#E2E8F0" backcolor="#F8FAFC" mode="Opaque">
            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </element>
        <element kind="textField" x="6" y="166" width="122" height="10" forecolor="#64748B"
                 fontName="SansSerif" fontSize="6.5" bold="true">
            <expression><![CDATA[$P{K5_LABEL}]]></expression>
        </element>
        <element kind="textField" x="6" y="176" width="122" height="18" forecolor="#22366B"
